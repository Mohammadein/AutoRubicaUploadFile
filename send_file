import os
from telegram import Update
from telegram.ext import ApplicationBuilder, MessageHandler, filters, ContextTypes

# خواندن Token از محیط
BOT_TOKEN = os.environ.get("TOKEN")
if not BOT_TOKEN:
    raise RuntimeError("Environment variable TOKEN is not set. Use: export TOKEN=YOUR_TOKEN")

# مسیر صحیح فایل‌ها
# اگر داخل همین فولدر هستید:
SPLIT_DIR = "/home/mhj/bale_gpt_bot/"
# یا اگر می‌خوای از ~ استفاده کنی:
# SPLIT_DIR = os.path.expanduser("~/bale_gpt_bot/")

async def echo(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat_id = update.effective_chat.id

    await update.message.reply_text(f"Chat ID شما: {chat_id}")
    await update.message.reply_text("شروع ارسال فایل‌های تکه‌تیکه شده...")

    for filename in sorted(os.listdir(SPLIT_DIR)):
        if filename.startswith("part_"):
            filepath = os.path.join(SPLIT_DIR, filename)

            await context.bot.send_document(
                chat_id=chat_id,
                document=open(filepath, "rb"),
                caption=filename
            )

def main():
    application = (
        ApplicationBuilder()
        .token(BOT_TOKEN)
        .base_url("https://tapi.bale.ai/bot")
        .build()
    )

    application.add_handler(
        MessageHandler(filters.TEXT & ~filters.COMMAND, echo)
    )

    print("Bale Split File Sender Bot started...")
    application.run_polling()

if __name__ == "__main__":
    main()
